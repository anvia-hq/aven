# The web entry point: the platform's files and the control plane behind /api, the same contract as
# the Vite dev proxy (/api/* goes to the control plane with the prefix stripped). Caddy upgrades
# WebSockets on its own, which the desktop, the terminal and remote runners use.
#
# AVEN_SITE_ADDRESS is ":80" for plain HTTP, or a domain, for which Caddy gets a certificate.
#
# A runner's ports are served on their own hosts (decision 0237), with AVEN_PREVIEW_DOMAIN set: give Caddy a
# wildcard certificate and route that domain to the server's preview listener, which picks the runner and the
# port from Host. Uncomment and name the domain:
# *.preview.example.com {
# 	reverse_proxy {$AVEN_UPSTREAM:server:8001}
# }
{$AVEN_SITE_ADDRESS::80} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy {$AVEN_UPSTREAM:server:8000} {
			# The agent's events are server-sent: send them as they come.
			flush_interval -1
		}
	}

	handle {
		root * /srv
		# Built files carry a hash in their name, so they never change.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Client-side routes fall back to the app.
		try_files {path} /index.html
		file_server
	}
}
