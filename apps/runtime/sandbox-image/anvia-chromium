#!/bin/sh
# The browser for the sandbox desktop: Google Chrome where it is installed (amd64), else Chromium
# (arm64, where Google ships no Chrome). Run it from a terminal or with xdotool; it draws on the
# daemon's display.
#
# The browser's own sandbox needs user namespaces, which Docker's default seccomp profile blocks. The
# container is already the isolation boundary, so this starts it with --no-sandbox. Set
# ANVIA_CHROMIUM_SANDBOX=1 to keep the browser's sandbox instead (run the container with a seccomp
# profile that allows user namespaces, or with --cap-add SYS_ADMIN).
#
# --test-type hides the "unsupported command-line flag: --no-sandbox" banner, which would otherwise
# sit at the top of every screenshot an agent takes.
if [ "${ANVIA_CHROMIUM_SANDBOX:-0}" = "1" ]; then
  sandbox_flags="--disable-setuid-sandbox"
else
  sandbox_flags="--no-sandbox --test-type"
fi
browser=$(command -v google-chrome-stable || command -v chromium)
# shellcheck disable=SC2086  # the flags are meant to be split
exec "$browser" \
  --no-first-run \
  --no-default-browser-check \
  --password-store=basic \
  --disable-dev-shm-usage \
  $sandbox_flags \
  --user-data-dir="${ANVIA_BROWSER_PROFILE:-$HOME/.chrome-profile}" \
  "$@"
