#!/bin/sh
# The Anvia daemon starts `openbox-session` as its window manager when it finds one; here that
# name starts a KDE Plasma session on the daemon's display instead.
export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=KDE KDE_FULL_SESSION=true
export XDG_RUNTIME_DIR="/tmp/runtime-$(id -u)"
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
# No GPU in a container: draw with software rendering.
export LIBGL_ALWAYS_SOFTWARE=1 KWIN_COMPOSE=O2ES QT_QUICK_BACKEND=software
exec dbus-run-session -- startplasma-x11
