# Settings for a self-hosted Aven. The installer writes this file as `.env` with the secrets filled
# in; edit it and run `aven restart` (or `docker compose up -d`) to apply a change.

# The version to run: a release such as 0.3.0, or latest. `aven update` changes it.
AVEN_VERSION=latest
# The port the web app is published on.
AVEN_PORT=3000
# ":80" serves plain HTTP. HTTPS with a domain comes with the `aven` CLI (decision 0073).
AVEN_SITE_ADDRESS=:80

# Where people open Aven: it must match what the browser shows, with no path. Auth cookies and the
# identity tokens' issuer depend on it.
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -base64 32. Encrypts stored provider keys and variables: changing it makes them unreadable.
PROVIDER_ENCRYPTION_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs the identity tokens a run can mint: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | awk '{printf "%s\\n", $0}'
WORKLOAD_IDENTITY_PRIVATE_KEY=

# Platform owners (comma separated emails): they can open and close registration.
PLATFORM_OWNER_EMAILS=

# Optional: Tavily key for the agent's web_search tool.
TAVILY_API_KEY=
# Optional: model providers the people who have not set up their own use. People add theirs in
# Settings > Providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub App for importing repositories (see .env.example in the repository for the permissions).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
