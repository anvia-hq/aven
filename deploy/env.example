# Settings for a self-hosted Aven. The installer writes this file as `.env` with the secrets filled
# in; edit it and run `aven restart` (or `docker compose up -d`) to apply a change.

# The version to run: a release such as 0.3.0, or latest. `aven update` changes it.
AVEN_VERSION=latest
# The address the web app's HTTP port is published on. 127.0.0.1 is this machine only (the default
# of a new install); 0.0.0.0 is every address, which with a domain is what Caddy needs; a private
# address such as a Tailscale one lets only that network in. Empty is every address, which is how an
# install made before this setting existed behaves. Plain HTTP across a network is not private:
# use a domain (HTTPS), a VPN, or a proxy that serves HTTPS in front.
AVEN_BIND=127.0.0.1
# The port the web app is published on (HTTP).
AVEN_PORT=2836
# ":80" serves plain HTTP. A domain such as aven.example.com makes Caddy get a certificate for it,
# which needs AVEN_PORT=80, AVEN_BIND=0.0.0.0, AVEN_HTTPS_PORT=443 and AVEN_HTTPS_BIND=0.0.0.0
# (`aven install --domain` sets all of them).
AVEN_SITE_ADDRESS=:80
AVEN_HTTPS_PORT=2838
AVEN_HTTPS_BIND=127.0.0.1
# The API on this machine only, which the runner beside the server and `aven` talk to.
AVEN_API_PORT=2837

# Where people open Aven: it must match what the browser shows, with no path. Auth cookies and the
# identity tokens' issuer depend on it.
BETTER_AUTH_URL=http://localhost:2836
TRUSTED_ORIGINS=http://localhost:2836
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -base64 32. Encrypts stored provider keys and variables: changing it makes them unreadable.
PROVIDER_ENCRYPTION_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs the identity tokens a run can mint: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | awk '{printf "%s\\n", $0}'
WORKLOAD_IDENTITY_PRIVATE_KEY=

# Whether anyone can register before an owner has opened or closed sign-ups in Settings > Platform
# (that choice wins): "open" or "closed". An install that others can reach (`aven install --domain`
# or --bind) starts closed, so only the owners below can make the first account; invite people from
# Settings > Members.
AVEN_REGISTRATION=open

# "off" turns email and password sign-in off, so people sign in with GitHub only (decision 0239). The
# server will not start with it off unless GITHUB_LOGIN_CLIENT_ID and _SECRET are set. Anything else is on.
AVEN_EMAIL_LOGIN=on

# More platform owners (comma separated emails). The first account made is an owner already; owners can open and close registration.
PLATFORM_OWNER_EMAILS=

# A decision model for every workspace that has not set one of its own (decision 0240): it reads multiplayer
# messages and gates the follow-up suggestions. Your key pays for those calls, which are short. Unset means
# a workspace sets its own in Settings > Decision model. KIND is "jev" or "jev-openrouter" (the default).
DECISION_MODEL_API_KEY=
# DECISION_MODEL_KIND=jev-openrouter
# DECISION_MODEL_ID=

# A small model for every person's follow-up suggestions, for people who have not chosen a provider of
# their own (decision 0241). It is still off until a person turns Follow-up suggestions on. Your key pays
# for its calls. Name a small, cheap model. PROVIDER is "anthropic" (default), "openai" or "gemini".
SMALL_MODEL_API_KEY=
# SMALL_MODEL_PROVIDER=anthropic
# SMALL_MODEL_ID=

# Optional "Continue with GitHub" on the sign-in and register pages (decision 0235). Create an OAuth
# app at github.com/settings/developers with Authorization callback URL =
# <BETTER_AUTH_URL>/api/auth/callback/github, then set both. Unset shows email and password only.
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=

# The server's own runner. "host" is a runner process on this machine (`aven runner`) that connects
# with AVEN_LOCAL_RUNNER_TOKEN, so a project works at once; "off" leaves it to the runners you
# attach in Settings > Runtimes. "on" runs sandboxes inside the server and cannot work in a container.
AVEN_LOCAL_RUNNER=host
# avrt_ and at least 32 more characters: echo "avrt_$(openssl rand -hex 24)"
AVEN_LOCAL_RUNNER_TOKEN=

# Hosts a model provider's address may name even when they resolve to a private or loopback address,
# such as a local Ollama (localhost). Comma separated host names. Empty refuses every internal address.
PROVIDER_ALLOWED_HOSTS=

# Optional: Tavily key for the agent's web_search tool.
TAVILY_API_KEY=
# Optional: model providers the people who have not set up their own use. People add theirs in
# Settings > Providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Where the model gateway sends Anthropic requests, for a proxy or a compatible service. Empty uses https://api.anthropic.com.
AVEN_ANTHROPIC_BASE_URL=
GEMINI_API_KEY=

# GitHub App for importing repositories (see .env.example in the repository for the permissions).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
