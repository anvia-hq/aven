{
  "name": "@aven/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./schema/*": "./src/schema/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "db:generate": "bun --env-file=../../.env run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/migrate.ts",
    "db:push": "bun --env-file=../../.env run drizzle-kit push",
    "db:studio": "bun --env-file=../../.env run drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
