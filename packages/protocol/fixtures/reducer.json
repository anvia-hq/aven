      {
        "type": "run_start",
        "prompt": "p"
      },
      {
        "type": "error",
        "message": "nope"
      }
    ],
    "expected": {
      "messages": [
        {
          "id": "m-0",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "p"
            }
          ]
        },
        {
          "id": "m-1",
          "role": "assistant",
          "parts": []
        }
      ],
      "running": false
    }
  },
  {
    "name": "an unknown event type is ignored",
    "events": [
      {
        "type": "run_start",
        "prompt": "p"
      },
      {
        "type": "something_new",
        "x": 1
      },
      {
        "type": "text",
        "delta": "still works"
      }
    ],
    "expected": {
      "messages": [
        {
          "id": "m-0",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "p"
            }
          ]
        },
        {
          "id": "m-1",
          "role": "assistant",
          "parts": [
            {
              "type": "text",
              "text": "still works"
            }
          ]
        }
      ],
      "running": true
    }
  },
  {
    "name": "reasoning gathers into parts between the tool calls",
    "events": [
      {
        "type": "run_start",
        "prompt": "fix it"
      },
      {
        "type": "reasoning",
        "delta": "The bug"
      },
      {
        "type": "reasoning",
        "delta": " is in parsing."
      },
      {
        "type": "tool_start",
        "tool": {
          "id": "t1",
          "name": "read",
          "target": "parse.ts",
          "status": "running"
        }
      },
      {
        "type": "tool_end",
        "id": "t1",
        "status": "done",
        "output": "..."
      },
      {
        "type": "reasoning",
        "delta": "\n\n"
      },
      {
        "type": "reasoning",
        "delta": "Now the fix."
      },
      {
        "type": "tool_start",
        "tool": {
          "id": "t2",
          "name": "edit",
          "target": "parse.ts",
          "status": "running"
        }
      },
      {
        "type": "tool_end",
        "id": "t2",
        "status": "done"
      },
      {
        "type": "text",
        "delta": "Fixed."
      },
      {
        "type": "done"
      }
    ],
    "expected": {
      "messages": [
        {
          "id": "m-0",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "fix it"
            }
          ]
        },
        {
          "id": "m-1",
          "role": "assistant",
          "parts": [
            {
              "type": "reasoning",
              "text": "The bug is in parsing."
            },
            {
              "type": "tool",
              "tool": {
                "id": "t1",
                "name": "read",
                "target": "parse.ts",
                "status": "done",
                "output": "..."
              }
            },
            {
              "type": "reasoning",
              "text": "Now the fix."
            },
            {
              "type": "tool",
              "tool": {
                "id": "t2",
                "name": "edit",
                "target": "parse.ts",
                "status": "done"
              }
            },
            {
              "type": "text",
              "text": "Fixed."
            }
          ]
        }
      ],
      "running": false
    }
  }
]
