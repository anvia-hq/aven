# Copy to .env and fill in values. Bun loads .env automatically.
NODE_ENV=development

# control-plane (backend)
PORT=8000
# Postgres connection string (packages/db). Local Postgres; create the db first: createdb aven
DATABASE_URL=postgres://localhost:5432/aven
# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public origin of the platform (frontend). Auth requests go through its /api proxy.
BETTER_AUTH_URL=http://localhost:5173
# Origins allowed to call the backend (comma separated).
TRUSTED_ORIGINS=http://localhost:5173
# "closed" starts with sign-ups closed (only owners and invited people can register) until an owner
# changes it in Settings -> Platform, which wins. Anything else is open.
AVEN_REGISTRATION=open
# More platform owners (comma separated emails). The first account made is an owner already; owners can open/close registration in Settings -> Platform.
PLATFORM_OWNER_EMAILS=you@example.com
# Tavily API key for the agents web_search tool (https://tavily.com).
TAVILY_API_KEY=tvly-your-key
# Fallback model providers for packages/agents, used when the sender has no provider of their own
# (users set theirs up in Settings -> Providers).
OPENAI_API_KEY=sk-your-key
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional. Where the model gateway sends Anthropic requests. Unset uses https://api.anthropic.com.
# AVEN_ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
# Agent model for threads. Provider is "anthropic" (default), "openai" or "gemini"; the model is optional
# and defaults per provider. Set the matching API key above.
AGENT_PROVIDER=anthropic
AGENT_MODEL=
# Encrypts users' provider API keys at rest (AES-256-GCM, 32 bytes base64). Generate with:
# openssl rand -base64 32. Changing it makes stored provider keys unreadable.
PROVIDER_ENCRYPTION_KEY=change-me-openssl-rand-base64-32
# Hosts a model provider's address may name even when they resolve to a private or loopback address, such as
# a local Ollama (localhost). Comma separated host names. Empty refuses every internal address (decision 0158).
PROVIDER_ALLOWED_HOSTS=
# Model catalog used to hide models that cannot drive the agent (embeddings, speech, image).
# Leave unset for models.dev; set it empty to skip the lookup and use a name check only.
MODEL_CATALOG_URL=https://models.dev/api.json
# Signs the OIDC identity tokens a run can mint (decision 0049): a PKCS#8 EC P-256 key, one line with literal
# \n. Generate with: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | awk '{printf "%s\\n", $0}'
# Without it a key is made per process and tokens stop verifying across a restart. The issuer is
# <BETTER_AUTH_URL>/api/workload-identity, which a provider must be able to reach for its keys.
WORKLOAD_IDENTITY_PRIVATE_KEY=
# A runtime (apps/runtime) connects out to a control plane. AVEN_URL is the control plane's own
# address (not the platform's /api proxy); the token is shown once when you create the runtime.
AVEN_URL=http://localhost:8000
AVEN_RUNTIME_TOKEN=
# Runner only (apps/runtime). A runner works on the machine it runs on (decision 0218): the agent runs as the
# user running the runner, in a folder it serves. AVEN_DIRS lists the folders it may open as projects,
# separated by colons (decision 0219). Use a computer you own: nothing is isolated.
AVEN_DIRS=
# For development set it to this project's own directory, as an absolute path, so a runner you run from
# the checkout never shares its journal, workspaces and containers with an installed Aven (`aven install`),
# which keeps its state in ~/.aven/runtime. `.aven/` is git-ignored:
#   AVEN_RUNTIME_HOME=/path/to/aven/.aven/runtime
# Left empty a runner uses ~/.aven/runtime, which is the installed app's.
AVEN_RUNTIME_HOME=
# The control plane works on its own machine too (a built-in runner serving AVEN_DIRS). Set to off to use only runners you attach, or to host to have a runner
# process on this machine (`aven runner`) connect as the built-in one with AVEN_LOCAL_RUNNER_TOKEN
# ("avrt_" and 32 or more characters), as a self-hosted server in a container does (decision 0073).
# Required while AVEN_LOCAL_RUNNER is not off, so the built-in runner's credential is the one you set
# and not one the server made up for that process alone. Make one with: echo "avrt_$(openssl rand -hex 24)"
AVEN_LOCAL_RUNNER=on
AVEN_LOCAL_RUNNER_TOKEN=
# The runner every bot's computer is on (decision 0059): the id of a runner you attached, shown in
# Settings > Runtimes. Empty uses the control plane's own, which needs AVEN_LOCAL_RUNNER=on.
AVEN_BOT_RUNNER=
# GitHub App (decision 0013): projects are imported repositories. A platform owner can create the app from
# Settings > Platform (decision 0074), with no variables here; to set one up by hand, create an app at
# github.com/settings/apps/new with: Callback URL = <BETTER_AUTH_URL>/api/github/callback, "Request user
# authorization (OAuth) during installation" on (GitHub then ignores the Setup URL), and Repository permissions
# Contents and Pull requests: read and write (the agent pushes and opens pull requests with gh, signed in as
# the person with their own GitHub token, decisions 0041 and 0044; an installation made with fewer must approve
# the new permissions), Actions, Checks and Commit statuses: read (so the agent can read CI with gh pr checks and
# gh run view --log-failed), and Metadata: read. Leave "Expire user authorization tokens"
# on, GitHub's default. Put its settings here; the private key may be one line with literal \n.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Optional: GitHub Enterprise Server. Defaults to github.com.
# GITHUB_API_URL=https://api.github.com
# GITHUB_WEB_URL=https://github.com

# Timing a run's start-up (decision 0119). Set it to anything to have the control plane and the
# runner log, for each message, how long every step before the model's first token took
# ("[timing] run <id> mcp 412ms (1832ms)"). Leave empty in normal use.
AVEN_TIMING=

# Where the newest release is looked up, for the Update button of the control plane's own runner
# (decision 0148) and for `aven update`. Leave empty to use GitHub's releases of anvia-hq/aven.
AVEN_RELEASES_URL=
