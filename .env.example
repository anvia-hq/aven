# Copy to .env and fill in values. Bun loads .env automatically.
NODE_ENV=development

# control-plane (backend)
PORT=8000
# Postgres connection string (packages/db). Matches docker-compose.yml.
DATABASE_URL=postgres://aven:aven@localhost:54329/aven
# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public origin of the platform (frontend). Auth requests go through its /api proxy.
BETTER_AUTH_URL=http://localhost:5173
# Origins allowed to call the backend (comma separated).
TRUSTED_ORIGINS=http://localhost:5173

# docker-compose.yml (postgres)
POSTGRES_USER=aven
POSTGRES_PASSWORD=aven
POSTGRES_DB=aven
POSTGRES_PORT=54329
