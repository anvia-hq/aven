# Copy to .env and fill in values. Bun loads .env automatically.
NODE_ENV=development

# control-plane (backend)
PORT=8000
# Postgres connection string (packages/db). Local Postgres; create the db first: createdb aven
DATABASE_URL=postgres://localhost:5432/aven
# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public origin of the platform (frontend). Auth requests go through its /api proxy.
BETTER_AUTH_URL=http://localhost:5173
# Origins allowed to call the backend (comma separated).
TRUSTED_ORIGINS=http://localhost:5173
# Platform owners (comma separated emails). They can open/close registration in Settings -> Platform.
PLATFORM_OWNER_EMAILS=you@example.com
# Tavily API key for the agents web_search tool (https://tavily.com).
TAVILY_API_KEY=tvly-your-key
# Fallback model providers for packages/agents, used when the sender has no provider of their own
# (users set theirs up in Settings -> Providers).
OPENAI_API_KEY=sk-your-key
ANTHROPIC_API_KEY=sk-ant-your-key
# Agent model for threads. Provider is "anthropic" (default) or "openai"; the model is optional
# and defaults per provider. Set the matching API key above.
AGENT_PROVIDER=anthropic
AGENT_MODEL=
# Encrypts users' provider API keys at rest (AES-256-GCM, 32 bytes base64). Generate with:
# openssl rand -base64 32. Changing it makes stored provider keys unreadable.
PROVIDER_ENCRYPTION_KEY=change-me-openssl-rand-base64-32
# Model catalog used to hide models that cannot drive the agent (embeddings, speech, image).
# Leave unset for models.dev; set it empty to skip the lookup and use a name check only.
MODEL_CATALOG_URL=https://models.dev/api.json
# A runtime (apps/runtime) connects out to a control plane. AVEN_URL is the control plane's own
# address (not the platform's /api proxy); the token is shown once when you create the runtime.
AVEN_URL=http://localhost:8000
AVEN_RUNTIME_TOKEN=
