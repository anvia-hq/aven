{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["node_modules", "dist", "**/routeTree.gen.ts", "packages/db/drizzle"],
  "jsPlugins": ["./tooling/oxlint/aven-plugin.mjs"],
  "rules": {
    "aven/no-conditional-spread": "error",
    "aven/no-barrel-file": "error",
    "no-nested-ternary": "error"
  }
}
