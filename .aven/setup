#!/usr/bin/env bash
# Checks the machine and installs what a thread needs. Versions: Bun 1.4.4 (apps/*/Dockerfile:
# oven/bun:1.4.4), PostgreSQL 17 (ci.yml and deploy/docker-compose.yml). Nothing deleted; sudo only on a sandbox without Docker, to install PostgreSQL 17.
set -euo pipefail
cd "$(dirname "$0")/.."

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$HOME/.bun/bin:$HOME/.npm-global/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

missing=0
need() {
  if command -v "$1" > /dev/null; then
    echo "ok       $1 $("$1" --version 2>&1 | head -n 1)"
  else
    echo "missing  $1: $2"
    missing=1
  fi
}

need git "install git"
need bun "curl -fsSL https://bun.sh/install | bash -s bun-v1.4.4"
command -v docker > /dev/null || echo "note     docker missing; on a sandbox with sudo PostgreSQL 17 is installed locally, otherwise install Docker or PostgreSQL 17 and set DATABASE_URL"
[ "$missing" -eq 0 ] || { echo "Install what is missing above, then run this again."; exit 1; }

want=1.4.4
have=$(bun --version)
[ "$have" = "$want" ] || echo "warn     bun $have, the Dockerfiles use $want (bun upgrade --version $want is not needed unless something breaks)"

if ! command -v docker > /dev/null && [ ! -x /usr/lib/postgresql/17/bin/postgres ] && sudo -n true 2> /dev/null; then
  echo "step     postgresql 17 (PGDG apt repository, sandbox only)"
  sudo apt-get update -qq > /dev/null
  sudo apt-get install -y -qq postgresql-common ca-certificates > /dev/null
  sudo /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y > /dev/null 2>&1
  sudo apt-get install -y -qq postgresql-17 > /dev/null
  sudo systemctl disable --now postgresql > /dev/null 2>&1 || true
  sudo pg_ctlcluster 17 main stop > /dev/null 2>&1 || true
fi

echo "step     dependencies"
bun install --frozen-lockfile > /dev/null

echo "step     chromium for e2e"
bunx playwright install chromium > /dev/null 2>&1 || echo "warn     playwright chromium not installed; run: bunx playwright install chromium"

if [ ! -f .env ]; then
  cp .env.example .env
  sed -i.bak "s|^BETTER_AUTH_SECRET=.*|BETTER_AUTH_SECRET=$(openssl rand -base64 32)|" .env
  sed -i.bak "s|^PROVIDER_ENCRYPTION_KEY=.*|PROVIDER_ENCRYPTION_KEY=$(openssl rand -base64 32)|" .env
  rm -f .env.bak
  echo "step     .env made from .env.example (local secrets generated)"
fi

for v in TAVILY_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY GEMINI_API_KEY; do
  [ -n "${!v:-}" ] || echo "note     $v not set; optional, add it in Settings > Variables"
done
echo "done     next: bash .aven/stack for PostgreSQL"
