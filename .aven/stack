#!/usr/bin/env bash
# Starts PostgreSQL 17 (postgres:17, as in ci.yml) in Docker, or the local PostgreSQL 17 when Docker is missing, on a per-thread port.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.local/bin:$HOME/.bun/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

offset=$(( $(pwd | cksum | cut -d' ' -f1) % 100 ))
port=$((55400 + offset))

if ! command -v docker > /dev/null && [ -x /usr/lib/postgresql/17/bin/postgres ]; then
  sudo pg_ctlcluster 17 main stop > /dev/null 2>&1 || true
  sudo pg_conftool 17 main set port "$port" > /dev/null
  sudo pg_ctlcluster 17 main start
  for _ in $(seq 1 30); do
    pg_isready -h localhost -p "$port" > /dev/null 2>&1 && break
    sleep 1
  done
  sudo -u postgres psql -p "$port" -qc "ALTER USER postgres PASSWORD 'postgres'" > /dev/null
  sudo -u postgres psql -p "$port" -tc "SELECT 1 FROM pg_database WHERE datname='aven'" | grep -q 1 \
    || sudo -u postgres createdb -p "$port" aven
  echo "DATABASE_URL=postgres://postgres:postgres@localhost:$port/aven" > .env.local
  echo "ready    postgres 17 (local) on localhost:$port (DATABASE_URL in .env.local)"
  echo "next     start the dev server as a process: bun run dev (control-plane 8000, platform 5173)"
  exit 0
fi
name="aven-pg-$offset"

if ! docker ps --format '{{.Names}}' | grep -qx "$name"; then
  docker rm "$name" > /dev/null 2>&1 || true
  docker run -d --name "$name" -p "127.0.0.1:$port:5432" \
    -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=aven postgres:17 > /dev/null
fi
for _ in $(seq 1 30); do
  docker exec "$name" pg_isready -h localhost -p 5432 -U postgres -d aven > /dev/null 2>&1 && break
  sleep 1
done
docker exec "$name" pg_isready -h localhost -p 5432 -U postgres -d aven

echo "DATABASE_URL=postgres://postgres:postgres@localhost:$port/aven" > .env.local
echo "ready    postgres 17 on localhost:$port (DATABASE_URL in .env.local)"
echo "next     start the dev server as a process: bun run dev (control-plane 8000, platform 5173)"
