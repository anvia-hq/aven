if [ "${AVEN_SKIP_E2E:-}" = "1" ]; then
  echo "pre-push: the e2e suite is skipped (AVEN_SKIP_E2E=1)"
  exit 0
fi

# e2e runs before the push that makes a branch, which is the push a pull request is made from.
# Every later push to the same branch waits for CI, so a review fix does not cost ten minutes.
creating=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    creating=1
  fi
done

if [ "$creating" -eq 0 ] && [ "${AVEN_FORCE_E2E:-}" != "1" ]; then
  echo "pre-push: this branch is already on the remote, so the e2e suite waits for CI."
  echo "pre-push: 'bun run test:e2e' runs it now; AVEN_FORCE_E2E=1 runs it before the push."
  exit 0
fi

echo "pre-push: running the e2e suite (CI runs the same tests in three shards)"
bun run test:e2e
