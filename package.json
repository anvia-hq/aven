{
  "name": "aven",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "sandbox"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "prepare": "husky || true",
    "typecheck": "bun check -b -p tsconfig.check.json",
    "lint": "bun lint",
    "lint:fix": "bun lint --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test": "bun test apps packages sandbox tooling",
    "test:e2e": "playwright test",
    "test:macos": "cd clients/macos/AvenKit && swift test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "1.4.3",
    "husky": "^9.1.7"
  }
}
