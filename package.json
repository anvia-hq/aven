{
  "name": "aven",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "typecheck": "bun run --filter '*' typecheck && tsc -p e2e",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:e2e": "playwright test",
    "test:macos": "cd clients/macos/AvenKit && swift test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "1.4.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^5"
  },
  "patchedDependencies": {
    "@anvia/durable@0.14.0": "patches/@anvia%2Fdurable@0.14.0.patch"
  }
}
