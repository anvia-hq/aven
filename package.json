{
  "name": "aven",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "sandbox"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "prepare": "husky || true",
    "typecheck": "bun run --filter '*' typecheck && tsc -p e2e",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test apps packages sandbox tooling",
    "test:e2e": "playwright test",
    "test:macos": "cd clients/macos/AvenKit && swift test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "1.4.3",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^5"
  }
}
